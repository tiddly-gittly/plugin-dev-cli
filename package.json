{
  "name": "tiddlywiki-plugin-dev",
  "author": "Sttot",
  "version": "0.4.4",
  "main": "./dist/js/index.js",
  "bin": {
    "tiddlywiki-plugin-dev": "./dist/js/main.js"
  },
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "keywords": [
    "tiddlywiki",
    "tiddlywiki5",
    "tiddlywiki-plugin",
    "tiddlywiki-theme"
  ],
  "repository": {
    "type ": "git",
    "url": "https://github.com/tiddly-gittly/plugin-dev-cli"
  },
  "homepage": "https://tiddly-gittly.github.io/Modern.TiddlyDev/",
  "bugs": {
    "url": "https://github.com/tiddly-gittly/plugin-dev-cli/issues"
  },
  "scripts": {
    "prepare": "modern build && husky install",
    "prepublishOnly": "modern build --platform",
    "dev": "modern dev",
    "build": "modern build",
    "reset": "rimraf ./**/node_modules",
    "lint": "modern lint",
    "change": "modern change",
    "bump": "modern bump",
    "pre": "modern pre",
    "change-status": "modern change-status",
    "gen-release-note": "modern gen-release-note",
    "release": "modern release",
    "new": "modern new",
    "test": "modern test --passWithNoTests",
    "upgrade": "modern upgrade"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "pnpm exec eslint --fix --color --cache --quiet"
    ],
    "*.{js,jsx,mjs,mjsx,cjs,cjsx}": [
      "pnpm exec eslint --fix --color --cache --quiet"
    ]
  },
  "eslintIgnore": [
    "node_modules/",
    "dist/"
  ],
  "dependencies": {
    "autoprefixer": "^10.4.27",
    "browserslist": "^4.28.1",
    "chalk": "^4.1.2",
    "chokidar": "^3.6.0",
    "clean-css": "^5.3.3",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.3",
    "esbuild": "^0.27.4",
    "esbuild-plugin-browserslist": "^2.0.0",
    "esbuild-style-plugin": "^1.6.3",
    "esbuild-svelte": "^0.9.4",
    "get-port-please": "^3.2.0",
    "html-minifier-terser": "^7.2.0",
    "ignore": "^7.0.5",
    "inquirer": "^8.2.7",
    "less": "^4.6.4",
    "lodash": "^4.17.23",
    "postcss-import": "^16.1.1",
    "sass": "^1.98.0",
    "sha256": "^0.2.0",
    "simple-git": "^3.33.0",
    "stylus": "^0.64.0",
    "tailwindcss": "^3.4.19",
    "uglify-js": "^3.19.3",
    "ws": "^8.20.0"
  },
  "peerDependencies": {
    "tiddlywiki": ">=5.2.0"
  },
  "peerDependenciesMeta": {
    "tiddlywiki": {
      "optional": false
    }
  },
  "optionalDependencies": {
    "svelte-preprocess": "^6.0.3"
  },
  "devDependencies": {
    "@modern-js/module-tools": "1.22.8",
    "@modern-js/plugin-testing": "1.22.8",
    "@modern-js/tsconfig": "1.22.8",
    "@types/clean-css": "^4.2.11",
    "@types/cli-progress": "^3.11.6",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/inquirer": "^8.2.12",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.5.0",
    "@types/sha256": "^0.2.2",
    "@types/uglify-js": "^3.17.5",
    "@types/ws": "^8.18.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "tiddlywiki": "5.3.8",
    "ts-node": "^10.9.2",
    "tw5-typed": "0.4.8",
    "typescript": "^5.9.3"
  },
  "sideEffects": [
    "*.css",
    "*.less",
    "*.sass",
    "*.scss"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
