{
  "extends": "@modern-js/tsconfig/base",
  "compilerOptions": {
    "declaration": false,
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "preserve",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@style/*": ["./styles/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/esbuild-inject.ts", "src/**/*.js"]
}
